{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [],
    "paths": {
      "@core/*": ["./core/*"],
      "@modules/*": ["./modules/*"]
    }
  },
  "include": ["core", "modules", "scripts", "src", "tests"]
}
